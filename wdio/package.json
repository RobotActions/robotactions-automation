{
  "name": "{{PROJECT_NAME}}",
  "version": "1.0.0",
  "description": "BDD test automation with WebdriverIO and Cucumber",
  "scripts": {
    "pretest": "[ -d node_modules ] || npm install",
    "test": "wdio run wdio.conf.ts",
    "test:web": "wdio run wdio.conf.ts",
    "test:web:smoke": "wdio run wdio.conf.ts --cucumberOpts.tagExpression='@smoke'",
    "test:regular": "wdio run wdio.mocha.conf.ts",
    "test:debug": "wdio run wdio.conf.ts --inspect",
    "test:mobile": "wdio run wdio.mobileweb.conf.ts",
    "test:mobile:android": "wdio run wdio.mobileweb.conf.ts",
    "test:mobile:android:smoke": "wdio run wdio.mobileweb.conf.ts --cucumberOpts.tagExpression='@smoke'",
    "test:mobile:ios": "wdio run wdio.ios-mobileweb.conf.ts",
    "test:mobile:ios:smoke": "wdio run wdio.ios-mobileweb.conf.ts --cucumberOpts.tagExpression='@smoke'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@wdio/cli": "^9.24.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/cucumber-framework": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/junit-reporter": "^9.0.0",
    "webdriverio": "^9.24.0",
    "typescript": "^5.7.0",
    "ts-node": "^10.9.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.0",
    "wdio-html-nice-reporter": "^3.2.0"
  }
}
