# ─────────────────────────────────────────────────────────────────────────────
# WebdriverIO + RobotActions Grid — example environment
#
# Copy to `.env` and fill in your values (`.env` is gitignored). Every wdio.*.conf.ts
# loads this via `import 'dotenv/config'`, so config files consume these variables
# rather than hardcoding anything.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application under test ───────────────────────────────────────────────────
BASE_URL=https://robotactions.com

# ── RobotActions Grid connection ─────────────────────────────────────────────
# GRID_HOST may include the port (host:port); GRID_PORT is the fallback.
GRID_HOST=localhost:5555
GRID_PORT=5555
GRID_PROTOCOL=http
# API token — the grid authorises via `Authorization: Bearer <token>`.
AUTH_TOKEN=your-auth-token-here

# ── Parallelism ──────────────────────────────────────────────────────────────
# Max concurrent WDIO workers. The grid distributes each worker's session to a
# free device, so set this to how many devices you want to use at once.
# Run N repeats of a spec:  npx wdio run <conf> --spec <feature> --repeat N
# For a reliable parallel demo, keep MAX_INSTANCES and --repeat at/below the
# number of free devices in the grid — otherwise excess sessions queue and can
# hit the cucumber step timeout (180s) while waiting for a device.
MAX_INSTANCES=1

# Dwell time (ms) for the robotactions-parallel.feature demo — how long each
# session holds the page so concurrent workers overlap and visibly spread across
# devices. Lower it for faster runs; raise it to make overlap more obvious.
PARALLEL_DWELL_MS=8000

# ── Device selection (mobile) ────────────────────────────────────────────────
# LEAVE THESE UNSET to let the grid AUTO-DISTRIBUTE across all matching devices
# (recommended). Set a comma-separated UDID list ONLY to pin to specific devices
# — the config adds `appium:udid` just for the first entry, so unset = no udid in
# caps = grid picks any free device.
#   Android:
# RA_DEVICE_UDIDS=
#   iOS:
# RA_IOS_UDIDS=

# ── Reporting / tagging (optional) ───────────────────────────────────────────
# Test-suite name surfaced to the grid (ra:testsuite).
RA_TESTSUITE=WebdriverIO
# Release identifier for grouping runs in reports.
# RA_RELEASE_ID=
# Cucumber tag filter, e.g. "@smoke" or "@ios and not @wip".
# TAGS=

# ── CI ───────────────────────────────────────────────────────────────────────
# CI=true forces headless where applicable (mobile drivers ignore it).
# CI=false
