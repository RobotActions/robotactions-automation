# Device configuration
PLATFORM=android

# Normally leave DEVICE_UDID unset. PLATFORM alone is enough: the grid picks any
# free device of that platform, which is what you want for CI and for anything
# that does not care which handset it lands on.
#
# Set it only to pin one specific device — reproducing a device-specific bug, or
# testing against a particular OS version. A UDID the grid does not have is
# answered with "No nodes support the capabilities in the request", so a made-up
# value here fails every run.
#
# To find a real UDID:
#   adb devices                     # Android, locally attached
#   idevice_id -l                   # iOS, locally attached (libimobiledevice)
#   curl -s localhost:4444/status   # every device the grid advertises
#
# The last one is usually what you want, because it lists what the *grid* can
# actually hand out rather than what happens to be plugged into your machine.
# Pipe it through jq to read it:
#   curl -s localhost:4444/status \
#     | jq -r '.value.nodes[].slots[].stereotype
#              | select(."appium:udid")
#              | "\(.platformName) \(."appium:deviceName") \(."appium:udid") \(."appium:platformVersion")"'
#
# DEVICE_UDID=

# Leave APP_PACKAGE / APP_ACTIVITY unset for a device-level smoke that needs no
# app installed. Set both to launch your app under test.
# APP_PACKAGE=com.mycompany.myapp
# APP_ACTIVITY=.ui.MainActivity

# iOS (uncomment for iOS testing)
# PLATFORM=ios
# BUNDLE_ID=com.example.app

# iOS 17+/18+ HID / CoreDevice-held devices (xcodebuild cannot launch WDA):
# launch a PREINSTALLED WDA runner via devicectl with zero xcodebuild.
# Install the runner once first (RDS: scripts/ios/install-wda-runner.sh <UDID>).
# USE_PREINSTALLED_WDA=true
# WDA_BUNDLE_ID=com.facebook.WebDriverAgentRunner
# Or attach to a WDA you launched yourself (warm-WDA model):
# WDA_URL=http://127.0.0.1:8100

# App install — path or URL to .apk/.ipa (auto-installs before tests)
# APP_PATH=/path/to/app.apk
# APP_PATH=https://example.com/builds/app-debug.apk

# Appium server / Remote Grid
GRID_HOST=localhost:5555
AUTH_TOKEN=your-auth-token-here
