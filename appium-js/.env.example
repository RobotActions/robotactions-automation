# Device configuration
PLATFORM=android

# Leave DEVICE_UDID unset to let the grid auto-distribute to any free device of
# the chosen platform. Set it only to pin one specific device — a UDID that the
# grid does not have is answered with "No nodes support the capabilities in the
# request", so a placeholder value here fails every run.
# DEVICE_UDID=R3CR10MH9KE

# Leave APP_PACKAGE / APP_ACTIVITY unset for a device-level smoke that needs no
# app installed. Set both to launch your app under test.
# APP_PACKAGE=com.mycompany.myapp
# APP_ACTIVITY=.ui.MainActivity

# iOS (uncomment for iOS testing)
# PLATFORM=ios
# BUNDLE_ID=com.example.app

# iOS 17+/18+ HID / CoreDevice-held devices (xcodebuild cannot launch WDA):
# launch a PREINSTALLED WDA runner via devicectl with zero xcodebuild.
# Install the runner once first (RDS: scripts/ios/install-wda-runner.sh <UDID>).
# USE_PREINSTALLED_WDA=true
# WDA_BUNDLE_ID=com.facebook.WebDriverAgentRunner
# Or attach to a WDA you launched yourself (warm-WDA model):
# WDA_URL=http://127.0.0.1:8100

# App install — path or URL to .apk/.ipa (auto-installs before tests)
# APP_PATH=/path/to/app.apk
# APP_PATH=https://example.com/builds/app-debug.apk

# Appium server / Remote Grid
GRID_HOST=localhost:5555
AUTH_TOKEN=your-auth-token-here
