{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["./pages/*"],
      "@steps/*": ["./steps/*"]
    }
  },
  "include": ["**/*.ts", "playwright.config.ts", "traceit.js"],
  "exclude": ["node_modules", "dist", ".features-gen", "scripts"]
}
