{
  // --- Cucumber language support (.feature files) -------------------------
  // The extension's defaults look for glue under features/ and tests/; this
  // template keeps steps in steps/ and locators in pages/, so without these
  // two settings every Given/When/Then shows up as undefined.
  "cucumber.features": [
    "features/**/*.feature"
  ],
  "cucumber.glue": [
    "steps/**/*.ts",
    "pages/**/*.ts"
  ],

  // --- Playwright extension ----------------------------------------------
  // Grid target, auth token and base URL are read from .env by config.ts, so
  // nothing is duplicated here: the extension runs Playwright with this folder
  // as cwd and dotenv picks the file up. Override per-machine in
  // .vscode/settings.json under "playwright.env" if you need to.
  "playwright.reuseBrowser": false,
  "playwright.showTrace": false,

  // .features-gen is generated by bddgen — edits there are lost on the next
  // run, so open them read-only and keep them out of search results.
  "files.readonlyInclude": {
    "**/.features-gen/**": true
  },
  "search.exclude": {
    "**/.features-gen": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/allure-results": true
  },

  "typescript.tsdk": "node_modules/typescript/lib"
}
