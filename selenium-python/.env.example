# Target platform: web | android | ios
PLATFORM=web

# Application under test (web)
BASE_URL=https://example.com

# Selenium / Appium Grid connection
GRID_URL=http://localhost:5555
AUTH_TOKEN=your-auth-token-here

# Mobile (Appium) — only used when PLATFORM=android|ios|mobileweb|ios-mobileweb
APP_PATH=/path/to/app.apk
DEVICE_UDID=emulator-5554
PLATFORM_VERSION=14
DEVICE_NAME=Pixel_7_API_34

# Android and Android TV/Chromecast share one Appium platformName, and the iOS
# fleet can hold an iPad alongside the iPhones — without a class filter a
# mobile run can land on the wrong device. android/mobileweb ask for `Phone`,
# ios/ios-mobileweb ask for `iPhone`. Override with DEVICE_CLASS if your fleet
# labels them differently.
# DEVICE_CLASS=

# iOS-specific
BUNDLE_ID=com.example.app
