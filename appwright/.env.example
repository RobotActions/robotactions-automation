# ─── Grid connection ─────────────────────────────────────────────────────────
# The endpoint your dashboard gives you: localhost:5555 for a local grid, 443
# for the hosted one. The token goes out as a bearer header on every request —
# config.ts hands both to Appwright's `robotactions` provider, so these two are
# all it needs. (ROBOTACTIONS_GRID_URL / ROBOTACTIONS_TOKEN, the provider's own
# names, are honoured too and win when set.)
GRID_HOST=localhost:5555
AUTH_TOKEN=your-auth-token-here

# ─── Platform ────────────────────────────────────────────────────────────────
# android | ios | tvos | androidtv | a comma-separated combination
# (one Playwright project per platform)
#
# The two TV platforms reuse their phone counterpart's driver — tvos is XCUITest
# like ios, androidtv is UiAutomator2 like android — so locators and assertions
# are identical. What differs is input: a TV has no touchscreen, so navigation
# goes through the remote's focus ring instead of taps. See the `remote` fixture
# and features/tv-remote.feature.
#
#   tvos       Apple TV
#   androidtv  Android TV, Google TV, Chromecast
#
# An androidtv run needs no DEVICE_UDID: the grid advertises deviceClass on every
# slot, so the template asks for a TV and gets any free one. Override the class
# with DEVICE_CLASS if your fleet labels them differently.
PLATFORM=android

# Normally leave DEVICE_UDID unset. PLATFORM alone is enough: the grid picks any
# free device of that platform, which is what you want for CI and for anything
# that does not care which handset it lands on.
#
# Set it only to pin one specific device — reproducing a device-specific bug, or
# testing against a particular OS version. A UDID the grid does not have is
# answered with "No nodes support the capabilities in the request", so a made-up
# value here fails every run. To list what the grid can actually hand out:
#   curl -s -H "Authorization: Bearer $AUTH_TOKEN" localhost:5555/status \
#     | jq -r '.value.nodes[].slots[].stereotype
#              | select(."appium:udid")
#              | "\(.platformName) \(."appium:deviceName") \(."appium:udid") \(."appium:platformVersion")"'
# DEVICE_UDID=

# ─── App under test ──────────────────────────────────────────────────────────
# Leave both unset for the device-level smoke, which needs no app installed and
# is what a fresh clone runs. Set one of them to run the @app suite.
#
# APP_ID — a build in your RobotActions App Library, by upload id. Upload on the
# dashboard (Apps), or from a URL:
#   curl -X POST https://<rds-host>/apps/import-url \
#        -H "Authorization: Bearer $AUTH_TOKEN" -H "Content-Type: application/json" \
#        -d '{"url":"https://ci.example.com/builds/app-debug.apk"}'      # → { "id": "…" }
# The grid fetches it with this run's token; nothing is hosted, no public URL.
# APP_ID=8eb08fc5-7a19-4037-bafe-c1437d855340
#
# APP_PATH — an https URL the grid can download, or an absolute path on the grid
# host. A file on this machine is not visible to the grid unless this machine
# is the grid. APP_ID wins when both are set.
# APP_PATH=https://example.com/builds/app-debug.apk
# APP_PATH=/srv/builds/app-debug.apk

# Android package / iOS bundle id. Needed to activate or terminate the app, and
# to read the clipboard on a real iOS device.
# APP_PACKAGE=com.mycompany.myapp
# APP_ACTIVITY=.ui.MainActivity
# BUNDLE_ID=com.mycompany.myapp

# Reinstall the build for each session (Appwright's own default) so every test
# starts from a first-launch state. Set false to keep the app and its data —
# much faster, at the cost of tests seeing each other's leftovers.
# APP_FULL_RESET=true

# ─── iOS automation runner ───────────────────────────────────────────────────
# iOS 17+/18+: building a runner at session start is unreliable. Install one on
# the device once, then point at it here.
# USE_PREINSTALLED_RUNNER=true
# IOS_RUNNER_BUNDLE_ID=com.facebook.WebDriverAgentRunner
# Or attach to a runner you launched yourself:
# IOS_RUNNER_URL=http://127.0.0.1:8100

# ─── Dashboard reporting ─────────────────────────────────────────────────────
# Suite label stored against the session, so runs are identifiable and group
# into a rollup card in the dashboard.
RA_TESTSUITE=Appwright
# Groups a run — a build number, tag or commit.
# RA_RELEASE_ID=build-42
# Record the request waterfall into the session's Network tab. Off by default:
# capture costs disk, and it only applies to webviews and mobile browsers.
# RA_NETWORK_CAPTURE=true

# ─── Settings walkthrough (@settings) ────────────────────────────────────────
# An app-level example that needs no build: it drives the preinstalled Settings
# app, read-only. Off by default because it asserts on STOCK Android/iOS labels —
# OEM skins rename them ("Network and Internet" is "Connections" on Samsung).
# Turn it on with DEVICE_UDID pinned to a stock handset, and WORKERS=1 (every
# worker would otherwise queue for that one device). Then: npm run test:settings
# RUN_SETTINGS_WALKTHROUGH=true

# ─── Run tuning ──────────────────────────────────────────────────────────────
# Workers default to 1 — a device is exclusive for the life of a session. Raise
# this to fan out across the fleet; with no DEVICE_UDID pinned the grid hands
# each worker a different free device. Never set it above the number of free
# devices on the platform.
# WORKERS=3
# EXPECT_TIMEOUT=20000
# TEST_TIMEOUT=240000
