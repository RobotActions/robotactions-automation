{
  // --- Cucumber language support (.feature files) -------------------------
  // The extension's defaults look for glue under features/ and tests/; this
  // template keeps steps in steps/ and locators in pageobjects/, so without
  // these two settings every Given/When/Then shows up as undefined.
  "cucumber.features": [
    "features/**/*.feature"
  ],
  "cucumber.glue": [
    "steps/**/*.ts",
    "pageobjects/**/*.ts"
  ],

  // --- Playwright extension ----------------------------------------------
  // Grid endpoint, token and platform are read from .env by config.ts, so
  // nothing is duplicated here: the extension runs Playwright with this folder
  // as cwd and dotenv picks the file up.
  //
  // Note the extension's green run arrows start a real device session per test,
  // the same as a CLI run. There is no browser to reuse, so reuseBrowser is off.
  "playwright.reuseBrowser": false,
  "playwright.showTrace": false,

  // .features-gen is generated by bddgen — edits there are lost on the next
  // run, so open them read-only and keep them out of search results.
  "files.readonlyInclude": {
    "**/.features-gen/**": true
  },
  "search.exclude": {
    "**/.features-gen": true,
    "**/test-results": true,
    "**/playwright-report": true
  },

  "typescript.tsdk": "node_modules/typescript/lib"
}
