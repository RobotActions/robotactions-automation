# Target platform: web | android | ios
PLATFORM=web

# Application under test (web)
BASE_URL=https://example.com

# Selenium / Appium Grid connection
GRID_URL=http://localhost:5555
AUTH_TOKEN=your-auth-token-here

# Mobile (Appium) — only used when PLATFORM=android|ios
APP_PATH=/path/to/app.apk
DEVICE_UDID=emulator-5554
PLATFORM_VERSION=14
DEVICE_NAME=Pixel_7_API_34

# iOS-specific
BUNDLE_ID=com.example.app
